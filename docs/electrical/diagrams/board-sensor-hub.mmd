    subgraph BOARD["SNS — Sensor Hub · board level"]
        direction LR
        PDB["PDB J6<br/>PWR_5V_AUX"]:::ext
        J1["J1 5V_IN<br/>Micro-Fit 2p"]:::conn
        T41["U1 Teensy 4.1<br/>IMXRT1062 · 3.3 V I/O<br/>pins NOT 5 V tolerant<br/>VUSB–VIN trace CUT"]:::ic
